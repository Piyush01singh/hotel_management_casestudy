# StayWise AI — Environment Configuration Example
# Copy this file to .env for local runtime configuration.

# Application Configuration
APP_NAME="StayWise AI"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration
# Local SQLite for deterministic local development and evaluation
DATABASE_URL="sqlite:///./backend/staywise.db"

# ML Pipeline Configuration
MODEL_ARTIFACTS_DIR="./ml/artifacts"
DEFAULT_FORECAST_HORIZON=7
PREDICTION_CUTOFF_SNAPSHOT="2024-06-30"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
